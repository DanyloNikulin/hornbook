# Cloud APIs — only if providers.transcribe/extract use openai or anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local extract (providers.extract.driver = ollama)
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_NUM_CTX=16384

# Local transcribe (providers.transcribe.driver = whisper-cli)
# WHISPER_BIN=whisper-cli
# WHISPER_MODEL=/path/to/ggml-medium.bin
