{
  "name": "hornbook",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "tsx scripts/backfill-topics.ts --auto && tsx scripts/build-derived.ts",
    "start": "concurrently -k -n server,ui -c blue,green \"tsx watch server/main.ts --no-static\" \"ng serve\"",
    "prebuild": "tsx scripts/backfill-topics.ts --auto && tsx scripts/build-derived.ts",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "tsx scripts/build-derived.ts",
    "test": "ng test",
    "test:scripts": "vitest run scripts server",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json}\"",
    "build-data": "tsx scripts/build-derived.ts",
    "process": "tsx scripts/process.ts",
    "lesson:new": "tsx scripts/lesson-new.ts",
    "regenerate": "tsx scripts/regenerate.ts",
    "cheatsheet": "tsx scripts/build-cheatsheet.ts",
    "cheatsheet:rebuild": "tsx scripts/build-cheatsheet.ts --force",
    "backfill-topics": "tsx scripts/backfill-topics.ts",
    "backfill-topics:dry": "tsx scripts/backfill-topics.ts --dry-run",
    "vocab-review": "tsx scripts/review-vocab.ts",
    "vocab-review:dry": "tsx scripts/review-vocab.ts --dry",
    "serve": "tsx server/main.ts",
    "server": "tsx watch server/main.ts --no-static",
    "migrate": "tsx scripts/migrate-journal.ts"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/common": "^21.2.22",
    "@angular/compiler": "^21.2.22",
    "@angular/core": "^21.2.22",
    "@angular/forms": "^21.2.22",
    "@angular/platform-browser": "^21.2.22",
    "@angular/router": "^21.2.22",
    "@anthropic-ai/sdk": "^0.98.0",
    "dompurify": "^3.4.14",
    "fuse.js": "^7.3.0",
    "marked": "^18.0.4",
    "openai": "^6.39.0",
    "rxjs": "~7.8.0",
    "sharp": "^0.35.4",
    "tslib": "^2.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^21.4.0",
    "@angular-eslint/eslint-plugin": "^21.4.0",
    "@angular-eslint/eslint-plugin-template": "^21.4.0",
    "@angular-eslint/template-parser": "^21.4.0",
    "@angular/build": "^21.2.22",
    "@angular/cli": "^21.2.22",
    "@angular/compiler-cli": "^21.2.22",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^22.20.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.4.0",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.0.8",
    "concurrently": "^9.2.1"
  }
}
